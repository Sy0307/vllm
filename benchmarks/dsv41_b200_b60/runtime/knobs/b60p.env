# B60 P (run pb-b60-1102a, 2026-11-02) = B59 P with the context-only budget replaced by the existing
# DP-shared step budget (_StepBalance): each rank's predicted cost is held to the largest demand the other ranks
# published (factor 1.0, floor ~4096 tokens), no context budget. RESEARCH_ZH section 58: in the replay of B56-B59 this
# cuts P latency 11-22% (p99 12-40%) and raises P capacity ~3.5%; factor 1.25 (m7, neutral) gives ~0.
# Same binary (ov-p85); knobs only.
OV_P=ov-p85
SCHED_POLICY=residual_sjf
EPLB_CFG={"window_size":1000,"step_interval":5000,"num_redundant_experts":16,"use_async":false,"communicator":"pynccl","log_balancedness":true,"log_balancedness_interval":1000}
VLLM_P_STEP_LOG=/gpfs/mszn/workspace/dsv41-di-vllm-20261021/pb/runs/pb-b60-1102a
VLLM_P_STEP_LOG_START={now+2700}
VLLM_P_STEP_LOG_ROWS=10000
VLLM_PREFILL_STEP_COST={"skip_scan":16,"e":6.83366,"a":0.00587,"b":1.32e-8,"b2":0,"d":0.94755,"g":4e-6}
VLLM_PREFILL_DP_BUDGET=1.0,32,1000
VLLM_MC_LOOKUP_STATS=2000
VLLM_INPUT_STATS=2000
DYN=1
VENV=/gpfs/mszn/workspace/dsv41-di-vllm-20261021/rebase/94a29d31-20261025/.venv
VLLM_FAST_BLOCK_HASH=1
VLLM_GIL_WATCHDOG=30
VLLM_GPU_GAP_LOG=500
VLLM_P_TOKEN_CAP=8192,4096,0,16,10,1.0
VLLM_REQ_TIMELINE=2000
VLLM_P_TL_DIR=/gpfs/mszn/workspace/dsv41-di-vllm-20261021/pb/runs/pb-b60-1102a
MC_SEG=80GB
VLLM_MC_LOAD_KICK=1
VLLM_MXFP8_PRECOMPILE=1
P_ENGRAM_PREFETCH=8
EXTRA_ARGS=--residual-sjf-max-wait-ms 10000
P_EARLY_RECV=1
P_LOOKUP_PREFETCH_LIMIT=256
P_LOOKUP_PREFETCH_TTL=60
VLLM_EARLY_RECV_THREAD=1
VLLM_EARLY_RECV_STATS=2000
