# B16 Dynamo layer: B14 prefill selection with prefill_load_scale 10 (compute terms dominate the per-request block term).
ROUTER_POLICY=router_policy_pcache2.yaml
# B39: frontend (and, via e2e_launch.sh, aiperf) on the D host, as InferenceX's multi-node AgentX recipes keep them off P.
FRONTEND_NODE=d
# Bound the frontend on the D host: 16 cores + HT siblings of NUMA 1, 32 Tokio workers, 64 blocking threads.
FRONTEND_CPUS=96-111,208-223
FRONTEND_THREADS=32
FRONTEND_BLOCKING=64
